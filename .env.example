# Copie este archivo como .env y complete los valores.
# NUNCA suba el archivo .env real al repositorio.

SECRET_KEY=coloque-aqui-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos --------------------------------------------------------
# Deje DATABASE_URL vacio o comentado para usar SQLite local.
# Para Supabase / Render, pegue aqui la cadena de conexion (Connection pooling):
# DATABASE_URL=postgresql://usuario:password@host:6543/postgres
DATABASE_URL=
DB_SSL_REQUIRED=True
